# Contraseña del usuario postgres de esta máquina.
# Solo sirve para crear la base. El sitio usa DATABASE_URL.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=

PGDATABASE=poesia

